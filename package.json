{
  "name": "a11yfix",
  "version": "0.1.0",
  "description": "Accessibility linter that writes the patch, not just the report. WCAG 2.2 and EAA, from your source: JSX, Vue, Svelte, HTML, CSS. Zero dependencies.",
  "keywords": [
    "accessibility",
    "a11y",
    "wcag",
    "wcag22",
    "eaa",
    "ada",
    "codemod",
    "autofix",
    "contrast",
    "jsx",
    "html",
    "audit",
    "report",
    "gost-r-52872",
    "accessibility-overlay",
    "web-accessibility",
    "accessibility-testing",
    "section508",
    "ada-compliance",
    "contrast-checker",
    "linter",
    "static-analysis",
    "vue",
    "svelte"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "a11yfix": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node scripts/check-chars.mjs && node scripts/test.mjs",
    "check-chars": "node scripts/check-chars.mjs",
    "prepublishOnly": "npm run build",
    "docs": "npm run build && node scripts/gen-coverage.mjs && node scripts/gen-demo-svg.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/node": "^24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iam-artificis/a11yfix.git"
  },
  "bugs": {
    "url": "https://github.com/iam-artificis/a11yfix/issues"
  },
  "homepage": "https://github.com/iam-artificis/a11yfix#readme"
}
